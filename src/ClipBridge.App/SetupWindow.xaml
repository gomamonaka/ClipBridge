<Window x:Class="ClipBridge.App.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipBridge の設定" Width="650" Height="735" MinWidth="570" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#F5F7FA" FontFamily="Yu Gothic UI, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" ResizeMode="CanResize">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/Controls.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="32,28,32,22">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="2 台のクリップボードをつなぐ" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="両方の端末で、同じ OneDrive フォルダーと合言葉を設定します。" Foreground="#667384" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="21" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,10">
                <Border Background="White" BorderBrush="#DFE6EE" BorderThickness="1" CornerRadius="7" Padding="23">
                    <StackPanel>
                        <TextBlock Text="OneDrive の共有フォルダー" Style="{StaticResource FieldLabel}" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="FolderInput" AutomationProperties.Name="OneDrive 共有フォルダーのパス" /><Button Grid.Column="1" Content="選択…" Click="OnBrowseFolder" Margin="9,0,0,0" /></Grid>
                        <TextBlock Text="エクスプローラーで同期済みの OneDrive 内にあるフォルダーを選択してください。専用の ClipBridge フォルダーをおすすめします。" Style="{StaticResource FieldHelp}" />
                        <TextBlock Text="先に 1 台目を設定し、共有フォルダーの同期完了後に 2 台目を設定してください。" Style="{StaticResource FieldHelp}" Foreground="#277A78" />
                        <TextBlock Text="共通の合言葉" Style="{StaticResource FieldLabel}" Margin="0,23,0,7" />
                        <PasswordBox x:Name="PassphraseInput" MaxLength="1024" AutomationProperties.Name="共通の合言葉、12 文字以上" />
                        <TextBlock Text="12 文字以上。保存内容の暗号化に使います。もう一方の端末にも、同じ合言葉を入力してください。" Style="{StaticResource FieldHelp}" />
                        <TextBlock Text="合言葉をもう一度入力" Style="{StaticResource FieldLabel}" Margin="0,18,0,7" />
                        <PasswordBox x:Name="ConfirmPassphraseInput" MaxLength="1024" AutomationProperties.Name="共通の合言葉の確認" />
                        <TextBlock Text="この端末の名前" Style="{StaticResource FieldLabel}" Margin="0,23,0,7" />
                        <TextBox x:Name="DeviceNameInput" MaxLength="60" AutomationProperties.Name="この端末の名前" />
                        <TextBlock Text="「仕事のノート PC」など、コピー元を見分けられる名前にします。" Style="{StaticResource FieldHelp}" />
                    </StackPanel>
                </Border>
                <Border Background="#EAF0F7" CornerRadius="6" Padding="16,13" Margin="0,17,0,0">
                    <StackPanel><TextBlock Text="共有が届くまでの時間について" FontWeight="SemiBold" FontSize="12" /><TextBlock Text="コピーを検出するとすぐに保存します。もう一方の端末への到着には OneDrive の同期時間がかかります。両方の端末で OneDrive を起動し、共有フォルダーを「このデバイス上で常に保持する」に設定してください。" Foreground="#52667C" TextWrapping="Wrap" FontSize="12" LineHeight="20" Margin="0,6,0,0" /></StackPanel>
                </Border>
                <TextBlock x:Name="ErrorText" Foreground="#B13A3A" TextWrapping="Wrap" FontSize="12" LineHeight="20" Margin="0,12,0,0" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="0,20,0,0"><TextBlock Text="設定後、クリップボードの共有を開始します。" Foreground="#667384" FontSize="11" VerticalAlignment="Center" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="キャンセル" IsCancel="True" Margin="0,0,9,0" /><Button x:Name="SaveButton" Content="設定を保存" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnSave" /></StackPanel></Grid>
    </Grid>
</Window>
