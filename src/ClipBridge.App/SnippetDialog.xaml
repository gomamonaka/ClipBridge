<Window x:Class="ClipBridge.App.SnippetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="定型文を登録" Width="566" Height="540" MinWidth="460" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F3F7FA" Foreground="#183B50" FontFamily="Yu Gothic UI, Segoe UI" FontSize="12" UseLayoutRounding="True">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/Controls.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Border Background="{StaticResource CanvasBrush}"><Grid Margin="23,21">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock x:Name="DialogHeading" Text="定型文を登録" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,20" />
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0"><TextBlock Text="タイトル" Style="{StaticResource FieldLabel}" /><TextBox x:Name="TitleInput" MaxLength="120" Padding="8,6" FontSize="13" AutomationProperties.Name="定型文のタイトル" /></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="グループ" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="GroupInput" IsEditable="True" IsTextSearchEnabled="False" MinHeight="34" MaxHeight="34" Padding="6,4" FontSize="12" AutomationProperties.Name="定型文のグループ" /></StackPanel>
        </Grid>
        <TextBlock Grid.Row="2" Text="既存のグループを選ぶか、新しい名前を入力できます。" Foreground="#758392" FontSize="10" Margin="0,6,0,0" />
        <TextBlock Grid.Row="3" Text="本文" Style="{StaticResource FieldLabel}" Margin="0,16,0,7" />
        <TextBox Grid.Row="4" x:Name="BodyInput" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="10" FontSize="13" SpellCheck.IsEnabled="False" AutomationProperties.Name="定型文の本文" />
        <TextBlock Grid.Row="5" x:Name="ErrorText" Foreground="#B13A3A" TextWrapping="Wrap" FontSize="11" Margin="0,7,0,0" />
        <Grid Grid.Row="6" Margin="0,15,0,0"><TextBlock Text="Ctrl + Enter で保存" Foreground="#758392" FontSize="10" VerticalAlignment="Center" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="キャンセル" IsCancel="True" Margin="0,0,8,0" Padding="12,6" MinHeight="32" FontSize="12" /><Button Content="保存する" Style="{StaticResource PrimaryButton}" Click="OnSave" Padding="15,6" MinHeight="32" FontSize="12" /></StackPanel></Grid>
    </Grid></Border>
</Window>
