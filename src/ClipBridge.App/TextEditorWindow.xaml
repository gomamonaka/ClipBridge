<Window x:Class="ClipBridge.App.TextEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="履歴を編集・整形" Width="742" Height="634" MinWidth="670" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F3F7FA" Foreground="#183B50"
        FontFamily="Yu Gothic UI, Segoe UI" FontSize="12" UseLayoutRounding="True">
    <Window.Resources><ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/Controls.xaml" /></ResourceDictionary.MergedDictionaries>
        <Style x:Key="FormatButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="29" /><Setter Property="Padding" Value="10,5" /><Setter Property="FontSize" Value="11" /><Setter Property="Margin" Value="0,0,5,6" /></Style>
    </ResourceDictionary></Window.Resources>
    <Border Background="{StaticResource CanvasBrush}"><Grid Margin="23,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid><TextBlock Text="履歴を編集・整形" FontSize="21" FontWeight="SemiBold" /><Button x:Name="ResetButton" Content="元の内容に戻す" Style="{StaticResource QuietButton}" FontSize="11" MinHeight="29" Padding="9,5" HorizontalAlignment="Right" Click="OnReset" /></Grid>
        <TextBlock Grid.Row="1" Text="本文を直接編集するか、整形を選んでから保存します。元に戻す操作は Ctrl + Z です。" Foreground="#718896" FontSize="11" Margin="0,7,0,18" TextWrapping="Wrap" />
        <WrapPanel Grid.Row="2" Margin="0,0,0,2">
            <Button Content="行頭・行末の空白を削除" Style="{StaticResource FormatButton}" Click="OnTrimLines" />
            <Button Content="空行を削除" Style="{StaticResource FormatButton}" Click="OnRemoveBlankLines" />
            <Button Content="改行をスペースに" Style="{StaticResource FormatButton}" Click="OnJoinLines" />
            <Button Content="大文字" Style="{StaticResource FormatButton}" Click="OnUpperCase" />
            <Button Content="小文字" Style="{StaticResource FormatButton}" Click="OnLowerCase" />
            <Button Content="英数字を半角" Style="{StaticResource FormatButton}" Click="OnHalfWidth" ToolTip="英数字・記号・空白を半角にします。" />
            <Button Content="英数字を全角" Style="{StaticResource FormatButton}" Click="OnFullWidth" ToolTip="英数字・記号・空白を全角にします。" />
        </WrapPanel>
        <TextBox Grid.Row="3" x:Name="BodyInput" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="13" FontSize="13" BorderBrush="#CBDEE6" SpellCheck.IsEnabled="False" TextChanged="OnTextChanged" AutomationProperties.Name="編集する履歴の本文" />
        <Border Grid.Row="4" Background="#EAF2F6" BorderBrush="#DAE6ED" BorderThickness="1" Padding="10" Margin="0,12,0,0">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="検索する文字列" FontSize="10" Foreground="#647F90" Margin="0,0,0,5" /><TextBlock Grid.Column="2" Text="置換後の文字列" FontSize="10" Foreground="#647F90" Margin="0,0,0,5" /><CheckBox Grid.Column="3" x:Name="RegexInput" Content="正規表現" FontSize="10" Foreground="#647F90" Margin="12,0,0,5" VerticalAlignment="Center" ToolTip=".NET の正規表現を使います。置換には $1 などを使えます。" />
                <TextBox Grid.Row="1" x:Name="FindInput" Padding="8,6" FontSize="12" AutomationProperties.Name="置換する検索文字列" /><TextBox Grid.Row="1" Grid.Column="2" x:Name="ReplacementInput" Padding="8,6" FontSize="12" AutomationProperties.Name="置換後の文字列" /><Button Grid.Row="1" Grid.Column="3" Content="すべて置換" MinHeight="31" Padding="12,5" FontSize="11" Margin="10,0,0,0" Click="OnReplace" />
            </Grid>
        </Border>
        <Grid Grid.Row="5" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Foreground="#718896" FontSize="11" TextWrapping="Wrap" MinHeight="30" /><TextBlock Grid.Column="1" x:Name="CharacterCount" FontSize="10" Foreground="#718896" Margin="15,0,0,0" /></Grid>
        <Grid Grid.Row="6" Margin="0,3,0,0"><TextBlock Text="Ctrl + Enter で保存" Foreground="#718896" FontSize="10" VerticalAlignment="Center" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="キャンセル" IsCancel="True" Margin="0,0,8,0" MinHeight="33" Padding="13,6" FontSize="12" /><Button Content="履歴に保存" Style="{StaticResource PrimaryButton}" Click="OnSave" MinHeight="33" Padding="17,6" FontSize="12" /></StackPanel></Grid>
    </Grid></Border>
</Window>
